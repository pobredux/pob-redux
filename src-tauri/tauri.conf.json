{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoB Redux",
  "version": "0.4.8",
  "identifier": "dev.pobredux.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["pob", "pob2"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1QUM2QjRGNTJDMTFCMjgKUldRb0c4RlNUMnVzWll6M1kycVN6UHhpQ3VmSVo2Z0htc0xYVCtXcUhLM3dtNUtqWGN3OWR0b2sK",
      "endpoints": [
        "https://pobredux.com/update/latest.json",
        "https://github.com/pobredux/pob-redux/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "app": {
    "windows": [
      {
        "title": "PoB Redux",
        "width": 1520,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: pobasset: http://pobasset.localhost pobart: http://pobart.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost pobasset: http://pobasset.localhost pobart: http://pobart.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Path of Building for Path of Exile 1 and 2, rebuilt.",
    "longDescription": "A fast, modern desktop build planner for Path of Exile 1 and 2 that runs Path of Building Community's real calculation engines.",
    "resources": {
      "resources/pob/": "pob/",
      "resources/pob1/": "pob1/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  }
}
