{
  "name": "pob-redux",
  "private": true,
  "version": "0.4.7",
  "description": "Path of Building for Path of Exile 1 and 2, rebuilt.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "bun run i18n && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "tauri": "tauri",
    "sync": "cargo run -p pob-sync -- --tree-assets && cargo run -p pob-sync -- --game poe1 --tree-assets",
    "sync:poe2": "cargo run -p pob-sync -- --tree-assets",
    "sync:poe1": "cargo run -p pob-sync -- --game poe1 --tree-assets",
    "sync:fast": "cargo run -p pob-sync -- && cargo run -p pob-sync -- --game poe1",
    "ctl": "cargo run -p pob-engine --bin pobctl --",
    "golden": "cargo run -p pob-engine --bin pobctl -- --pob-root src-tauri/resources/pob golden corpus/index.json --out target/golden-poe2.json --baseline golden/poe2.json --check",
    "golden:accept": "cargo run -p pob-engine --bin pobctl -- --pob-root src-tauri/resources/pob golden corpus/index.json --out golden/poe2.json",
    "mcp": "bun scripts/mcp-call.ts",
    "check:tools": "bun scripts/check-tools.ts",
    "release:tag": "bun scripts/release.mjs",
    "i18n": "paraglide-js compile --project ./project.inlang"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.42",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "ai": "^7.0.89"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
